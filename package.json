{
  "name": "server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "serve": "bun run src/index.ts serve",
    "cli": "bun run src/index.ts",
    "overlay:sync": "bun run src/index.ts overlay sync",
    "overlay:list": "bun run src/index.ts overlay list",
    "rules:sync": "bunx dethz-crawler sync",
    "build:all": "bun run build.ts",
    "build:box": "bun run build-box.ts",
    "build:binary": "bun build --compile --outfile ../build/server src/index.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "chalk": "^6.0.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "tiktok-live-connector": "^2.1.1-beta1",
    "yaml": "^2.9.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}